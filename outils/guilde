---
- name: Installation du Kit de Veille
  hosts: localhost
  connection: local
  gather_facts: false
  tasks:
    - name: Suppression des anciennes tâches cron conflictuelles
      ansible.builtin.cron:
        name: "Ancienne Veille du Matin"
        state: absent

    - name: Configuration de la planification cron du kit de veille
      ansible.builtin.cron:
        name: "Rapport quotidien de veille"
        minute: "0"
        hour: "6"
        job: "/guilde/scripts/generer_rapport.sh"
        state: present
